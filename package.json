{
  "name": "photography-portfolio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "build:pages": "cross-env GH_PAGES=1 vite build && node -e \"require('fs').copyFileSync('dist/index.html','dist/404.html');require('fs').writeFileSync('dist/.nojekyll','')\"",
    "deploy": "tsc -b && npm run build:pages && gh-pages -d dist --dotfiles"
  },
  "dependencies": {
    "lenis": "^1.3.27",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "cross-env": "^10.1.0",
    "gh-pages": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
